# Names only. Ken pastes the values in Vercel (project oreheart-admin), never here.
# Both are public by design (they end up in the browser). NEVER add the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only if captcha (Cloudflare Turnstile) is on in Supabase: the public site key.
VITE_TURNSTILE_SITE_KEY=
# Which server this build is for: production (the real site) or test (previews). The site refuses to run if the server says otherwise.
VITE_OREHEART_ENV=
